:root {
    --bg: #f4f7fb;
    --surface: #ffffff;
    --surface-soft: #f8faff;

    --navy: #0b1220;
    --navy-2: #111c31;

    --primary: #405de6;
    --primary-soft: #e9edff;

    --teal: #18a999;
    --teal-soft: #e6f8f5;

    --orange: #f59e0b;
    --orange-soft: #fff5df;

    --red: #e5484d;
    --red-soft: #ffeaeb;

    --green: #16a36a;
    --green-soft: #e7f8f0;

    --purple: #805ad5;
    --purple-soft: #f0eaff;

    --text: #172033;
    --text-soft: #6d778b;
    --border: #e6eaf1;

    --shadow-small:
        0 4px 16px rgba(22, 34, 58, 0.06);

    --shadow:
        0 12px 32px rgba(22, 34, 58, 0.08);

    --radius: 22px;
    --radius-small: 16px;
}


* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}


html {
    height: 100%;
}


body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    overflow-x: hidden;
}


button {
    font: inherit;
}


button:focus {
    outline: none;
}


#app {
    min-height: 100vh;
    padding-bottom: 92px;
}


/* ================================= */
/* HEADER */
/* ================================= */

.app-header {
    min-height: 82px;
    padding:
        18px
        20px
        14px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background:
        linear-gradient(
            135deg,
            var(--navy),
            var(--navy-2)
        );

    color: white;

    position: sticky;
    top: 0;
    z-index: 50;

    box-shadow:
        0 8px 24px rgba(11, 18, 32, 0.16);
}


.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}


.brand-mark {
    width: 44px;
    height: 44px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #6578ff,
            #405de6
        );

    font-weight: 800;
    font-size: 14px;

    box-shadow:
        0 8px 20px rgba(64, 93, 230, 0.32);
}


.brand-title {
    font-size: 17px;
    font-weight: 750;
    letter-spacing: -0.2px;
}


.brand-subtitle {
    margin-top: 2px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.62);
}


.icon-button {
    width: 42px;
    height: 42px;

    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;

    background: rgba(255,255,255,0.08);
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;

    cursor: pointer;
}


/* ================================= */
/* MAIN */
/* ================================= */

.main-content {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;

    padding:
        24px
        18px
        32px;
}


.screen {
    display: none;
    animation: screenIn 0.28s ease;
}


.screen.active {
    display: block;
}


@keyframes screenIn {

    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


/* ================================= */
/* WELCOME */
/* ================================= */

.welcome-section {
    margin-bottom: 22px;
}


.eyebrow {
    display: block;

    color: var(--primary);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1.6px;

    margin-bottom: 7px;
}


.welcome-section h1,
.screen-heading h1 {
    margin: 0;

    font-size: 32px;
    line-height: 1.1;

    letter-spacing: -1px;
}


.welcome-section p {
    margin:
        8px
        0
        0;

    color: var(--text-soft);

    font-size: 14px;
}


/* ================================= */
/* FOCUS CARD */
/* ================================= */

.focus-card {
    padding: 22px;

    border-radius: 26px;

    background:
        linear-gradient(
            135deg,
            #101b32,
            #172848
        );

    color: white;

    box-shadow:
        0 18px 40px rgba(11, 18, 32, 0.20);

    overflow: hidden;

    position: relative;
}


.focus-card::after {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    border-radius: 50%;

    right: -70px;
    top: -70px;

    background:
        radial-gradient(
            circle,
            rgba(104, 125, 255, 0.32),
            transparent 68%
        );
}


.focus-top {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}


.small-label {
    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1.4px;

    color: rgba(255,255,255,0.56);
}


.focus-card h2 {
    margin:
        8px
        0
        0;

    font-size: 20px;
    letter-spacing: -0.4px;
}


.focus-icon {
    width: 46px;
    height: 46px;

    border-radius: 16px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(255,255,255,0.09);

    font-size: 20px;
}


.focus-progress {
    margin-top: 24px;
}


.progress-track {
    height: 7px;

    background: rgba(255,255,255,0.10);

    border-radius: 20px;

    overflow: hidden;
}


.progress-value {
    width: 8%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            #687cff,
            #53d7c8
        );

    border-radius: 20px;

    transition: width 0.5s ease;
}


.focus-footer {
    margin-top: 12px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    font-size: 11px;

    color: rgba(255,255,255,0.58);
}


/* ================================= */
/* SECTION HEADING */
/* ================================= */

.section-heading {
    margin:
        28px
        0
        12px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}


.section-heading h2 {
    margin: 0;

    font-size: 17px;
    letter-spacing: -0.3px;
}


.section-heading > span {
    color: var(--text-soft);
    font-size: 12px;
}


.text-button {
    border: none;
    background: transparent;

    color: var(--primary);

    font-size: 12px;
    font-weight: 700;

    padding: 4px;

    cursor: pointer;
}


/* ================================= */
/* SUMMARY */
/* ================================= */

.summary-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}


.summary-card {
    border: 1px solid var(--border);

    border-radius: var(--radius);

    background: var(--surface);

    padding: 16px;

    text-align: left;

    box-shadow: var(--shadow-small);

    cursor: pointer;

    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
}


.summary-card:active {
    transform: scale(0.98);
}


.summary-icon {
    width: 38px;
    height: 38px;

    border-radius: 13px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 12px;

    font-size: 17px;
}


.letters-card .summary-icon {
    background: var(--primary-soft);
    color: var(--primary);
}


.tasks-card .summary-icon {
    background: var(--green-soft);
    color: var(--green);
}


.reminders-card .summary-icon {
    background: var(--orange-soft);
    color: var(--orange);
}


.matters-card .summary-icon {
    background: var(--purple-soft);
    color: var(--purple);
}


.summary-number {
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
}


.summary-label {
    margin-top: 6px;

    font-size: 13px;
    font-weight: 700;
}


.summary-status {
    margin-top: 3px;

    color: var(--text-soft);

    font-size: 10px;
}


/* ================================= */
/* EMPTY CARD */
/* ================================= */

.empty-card {
    border:
        1px
        dashed
        var(--border);

    background: rgba(255,255,255,0.72);

    border-radius: var(--radius);

    padding: 24px;

    text-align: center;
}


.empty-card.large-empty {
    padding:
        44px
        24px;
}


.empty-icon {
    width: 54px;
    height: 54px;

    border-radius: 18px;

    margin: 0 auto 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary-soft);

    color: var(--primary);

    font-size: 22px;
}


.empty-card h3 {
    margin:
        0
        0
        7px;

    font-size: 16px;
}


.empty-card p {
    margin: 0;

    color: var(--text-soft);

    font-size: 12px;
    line-height: 1.6;
}


/* ================================= */
/* QUICK ACTIONS */
/* ================================= */

.quick-actions {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 10px;
}


.quick-action {
    border: 1px solid var(--border);

    background: var(--surface);

    border-radius: 18px;

    min-height: 82px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    color: var(--text);

    box-shadow: var(--shadow-small);

    cursor: pointer;
}


.quick-action span {
    font-size: 19px;
    color: var(--primary);
}


.quick-action strong {
    font-size: 10px;
}


/* ================================= */
/* SCREEN HEADINGS */
/* ================================= */

.screen-heading {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 22px;
}


.screen-heading h1 {
    font-size: 30px;
}


.primary-small {
    border: none;

    border-radius: 13px;

    padding:
        10px
        14px;

    background: var(--primary);
    color: white;

    font-size: 12px;
    font-weight: 750;

    box-shadow:
        0 7px 16px rgba(64, 93, 230, 0.22);

    cursor: pointer;
}


/* ================================= */
/* TABS */
/* ================================= */

.tab-bar {
    display: flex;

    gap: 6px;

    padding: 5px;

    margin-bottom: 18px;

    border-radius: 16px;

    background: #e9edf4;

    overflow-x: auto;
}


.tab-button {
    border: none;

    background: transparent;

    color: var(--text-soft);

    padding:
        9px
        12px;

    border-radius: 12px;

    white-space: nowrap;

    font-size: 11px;
    font-weight: 700;

    cursor: pointer;
}


.tab-button.active {
    background: white;

    color: var(--text);

    box-shadow:
        0 3px 10px rgba(22,34,58,0.08);
}


/* ================================= */
/* LETTER SUMMARY */
/* ================================= */

.letter-summary {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 9px;

    margin-bottom: 14px;
}


.letter-summary > div {
    padding: 14px;

    border-radius: 17px;

    background: white;

    border: 1px solid var(--border);

    box-shadow: var(--shadow-small);
}


.letter-summary span {
    display: block;

    font-size: 9px;

    color: var(--text-soft);

    margin-bottom: 7px;
}


.letter-summary strong {
    font-size: 23px;
}


/* ================================= */
/* OFFICE GRID */
/* ================================= */

.office-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}


.office-card {
    min-height: 130px;

    border: 1px solid var(--border);

    border-radius: var(--radius);

    background: white;

    text-align: left;

    padding: 18px;

    display: flex;
    flex-direction: column;

    justify-content: space-between;

    box-shadow: var(--shadow-small);

    cursor: pointer;
}


.office-card > span {
    width: 42px;
    height: 42px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary-soft);
    color: var(--primary);

    font-size: 18px;
}


.office-card strong {
    margin-top: 14px;

    font-size: 14px;
}


.office-card small {
    margin-top: 4px;

    color: var(--text-soft);

    font-size: 10px;
}


/* ================================= */
/* REMINDER PANEL */
/* ================================= */

.reminder-panel {
    margin-top: 24px;
}


/* ================================= */
/* BOTTOM NAVIGATION */
/* ================================= */

.bottom-navigation {
    position: fixed;

    left: 0;
    right: 0;
    bottom: 0;

    height: 78px;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    align-items: center;

    padding:
        8px
        12px
        calc(8px + env(safe-area-inset-bottom));

    background:
        rgba(255,255,255,0.94);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    border-top:
        1px solid
        rgba(220,225,234,0.8);

    box-shadow:
        0 -8px 28px rgba(22,34,58,0.08);

    z-index: 100;
}


.nav-item {
    height: 60px;

    border: none;

    background: transparent;

    color: #8992a3;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 4px;

    font-size: 10px;
    font-weight: 650;

    cursor: pointer;

    border-radius: 16px;
}


.nav-icon {
    font-size: 20px;
    line-height: 1;
}


.nav-item.active {
    color: var(--primary);
}


.nav-item.active .nav-icon {
    transform: translateY(-1px);
}


/* ================================= */
/* MODAL */
/* ================================= */

.modal-overlay {
    position: fixed;

    inset: 0;

    display: none;
    align-items: flex-end;

    background:
        rgba(6, 12, 24, 0.48);

    z-index: 200;

    padding: 14px;
}


.modal-overlay.active {
    display: flex;
}


.modal-card {
    width: 100%;

    max-width: 600px;

    margin: 0 auto;

    border-radius:
        28px
        28px
        22px
        22px;

    background: white;

    padding: 26px;

    position: relative;

    animation:
        modalIn 0.25s ease;
}


@keyframes modalIn {

    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


.modal-close {
    position: absolute;

    right: 16px;
    top: 16px;

    width: 34px;
    height: 34px;

    border: none;

    border-radius: 50%;

    background: #f0f2f6;

    color: var(--text-soft);

    font-size: 20px;

    cursor: pointer;
}


.modal-icon {
    width: 52px;
    height: 52px;

    border-radius: 17px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary-soft);

    color: var(--primary);

    font-size: 24px;

    margin-bottom: 14px;
}


.modal-card h2 {
    margin: 0;

    font-size: 22px;
}


.modal-card p {
    color: var(--text-soft);

    font-size: 13px;

    line-height: 1.5;
}


.modal-actions {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 10px;

    margin-top: 20px;
}


.modal-action-button {
    border: 1px solid var(--border);

    background: var(--surface-soft);

    border-radius: 16px;

    padding: 15px;

    color: var(--text);

    font-weight: 700;

    cursor: pointer;
}


/* ================================= */
/* RESPONSIVE */
/* ================================= */

@media (min-width: 700px) {

    .summary-grid {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .quick-actions {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .bottom-navigation {
        max-width: 760px;
        left: 50%;
        right: auto;

        transform: translateX(-50%);

        width: 100%;

        border:
            1px solid
            rgba(220,225,234,0.8);

        border-radius:
            24px
            24px
            0
            0;
    }

}


@media (max-width: 380px) {

    .main-content {
        padding-left: 14px;
        padding-right: 14px;
    }

    .welcome-section h1 {
        font-size: 28px;
    }

    .summary-card {
        padding: 14px;
    }

    .quick-action {
        min-height: 74px;
    }

}
